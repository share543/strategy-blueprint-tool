{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strategy Blueprint Tool - Data Model",
  "version": "2.1.0",
  "description": "公司策略藍圖發展工具 - 資料模型（v2.1：KPI 方向計算、建議可回溯成效、自動推導）",
  "type": "object",
  "required": ["meta", "vision", "swot", "metrics", "strategies", "actions", "kpis", "outcomes", "suggestions"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "description": "公司名稱" },
        "year": { "type": "number", "description": "年度" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "version": { "type": "string", "default": "2.1" }
      },
      "required": ["companyName", "year"]
    },
    "vision": {
      "type": "object",
      "properties": {
        "mission": { "type": "string", "description": "使命" },
        "vision": { "type": "string", "description": "願景" },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "description": "核心價值觀"
        }
      },
      "required": ["mission", "vision"]
    },
    "swot": {
      "type": "object",
      "properties": {
        "strengths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "優勢"
        },
        "weaknesses": {
          "type": "array",
          "items": { "type": "string" },
          "description": "劣勢"
        },
        "opportunities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "機會"
        },
        "threats": {
          "type": "array",
          "items": { "type": "string" },
          "description": "威脅"
        }
      },
      "required": ["strengths", "weaknesses", "opportunities", "threats"]
    },
    "metrics": {
      "type": "array",
      "description": "現況數據指標",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "description": "指標名稱" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "category": { "type": "string", "description": "分類：財務/客戶/內部流程/學習成長" },
          "note": { "type": "string" }
        },
        "required": ["id", "name", "value", "unit"]
      }
    },
    "strategies": {
      "type": "array",
      "description": "策略主題",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "string", "enum": ["高", "中", "低"] },
          "status": { "type": "string", "enum": ["草案", "進行中", "已完成", "暫停"] }
        },
        "required": ["id", "title", "description", "priority"]
      }
    },
    "actions": {
      "type": "array",
      "description": "行動方案",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "strategyId": { "type": "string", "description": "所屬策略主題" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "owner": { "type": "string", "description": "負責人" },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "status": { "type": "string", "enum": ["未開始", "進行中", "已完成", "暫停"] },
          "progress": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["id", "strategyId", "title", "owner", "status"]
      }
    },
    "kpis": {
      "type": "array",
      "description": "KPI 追蹤",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "actionId": { "type": "string", "description": "所屬行動方案" },
          "name": { "type": "string" },
          "direction": {
            "type": "string",
            "enum": ["up", "down"],
            "default": "up",
            "description": "v2.1 新增。up=越高越好；down=越低越好（流失率、空駛里程等）。down 時達成率以 (baseline-current)/(baseline-target) 計算，否則 current/target 會讓數字變差卻顯示滿分"
          },
          "baseline": {
            "type": "number",
            "description": "v2.1 新增。降低型 KPI 的計畫起點，用來計算落差。舊資料由 normalizeData() 以 currentValue 自動補上"
          },
          "currentValue": { "type": "number" },
          "targetValue": { "type": "number" },
          "unit": { "type": "string" },
          "deadline": { "type": "string", "format": "date" }
        },
        "required": ["id", "actionId", "name", "targetValue", "unit"]
      }
    },
    "outcomes": {
      "type": "array",
      "description": "成效追蹤紀錄 —— 遞迴自我改進的輸入。記錄每期策略執行結果，供改進建議與回顧使用。",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "唯一識別碼（前綴 o）" },
          "strategyId": { "type": "string", "description": "所屬策略主題 ID" },
          "period": { "type": "string", "description": "期間標記，例：2026-Q4" },
          "completionRate": { "type": "number", "minimum": 0, "maximum": 100, "description": "完成率百分比" },
          "score": { "type": "number", "minimum": 1, "maximum": 5, "description": "成效評分 1-5" },
          "notes": { "type": "string", "description": "備註 / 經驗教訓" }
        },
        "required": ["id", "strategyId", "completionRate", "score"]
      }
    },
    "suggestions": {
      "type": "array",
      "description": "改進建議 —— 遞迴自我改進的產出。記錄從成效歸納出的改進方向與其處理狀態。",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "唯一識別碼（前綴 sg）" },
          "outcomeId": {
            "type": "string",
            "default": "",
            "description": "v2.1 新增。來源成效紀錄 ID，讓建議可回溯到是哪筆成效歸納出來的"
          },
          "strategyId": {
            "type": "string",
            "default": "",
            "description": "v2.1 新增。相關策略 ID（跨策略的建議可留空）"
          },
          "autoGenerated": {
            "type": "boolean",
            "default": false,
            "description": "v2.1 新增。是否由自動推導產生（UI 會標示「自動推導」）"
          },
          "issue": { "type": "string", "description": "問題描述" },
          "suggestion": { "type": "string", "description": "改進建議內容" },
          "priority": { "type": "string", "enum": ["高", "中", "低"] },
          "status": { "type": "string", "enum": ["待處理", "已接受", "已拒絕", "已實施"] }
        },
        "required": ["id", "issue", "suggestion", "priority", "status"]
      }
    }
  }
}
